# ---- Eidolon Network / Ports (see docs/ports.md) ----
EIDOLON_WEB_HOST=0.0.0.0
EIDOLON_WEB_PORT=26880
EIDOLON_API_HOST=127.0.0.1
EIDOLON_API_PORT=26881
EIDOLON_METRICS_PORT=26890
EIDOLON_RUNTIME_DEBUG_PORT_START=26900
EIDOLON_RUNTIME_DEBUG_PORT_END=26999

# ---- Eidolon Backend ----
EIDOLON_RUNTIME_MODE=mock
EIDOLON_UPDATE_CHECK_ENABLED=true
EIDOLON_UPDATE_CHECK_INTERVAL=21600
EIDOLON_UPDATE_POLICY=notify_only
EIDOLON_RUNTIME_HEALTHCHECK_INTERVAL=30
EIDOLON_DATABASE_URL=sqlite:///./data/eidolon.db
EIDOLON_DATA_ROOT=./data
EIDOLON_WORKSPACE_ROOT=./data/workspaces
EIDOLON_MOCK_TASK_SECONDS=8
EIDOLON_LOG_LEVEL=INFO
EIDOLON_CORS_ORIGINS=http://localhost:26880
EIDOLON_COMPANY_NAME=Eidolon Studio
# New installations begin with zero employees. Enable only for legacy/demo fixtures.
EIDOLON_SEED_DEMO_WORKFORCE=false
EIDOLON_SECRET_KEY=change-me-in-production

# ---- v0.2 Runtime Images ----
EIDOLON_HERMES_IMAGE=nousresearch/hermes-agent:latest
EIDOLON_OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# ---- v0.3 Git: optional builtin Gitea image (manual install via POST /api/v1/git/builtin/install) ----
EIDOLON_GITEA_IMAGE=gitea/gitea:1

# ---- v0.4 Lifecycle ----
# Admin API token for the builtin Gitea (fresh installs have no admin; git provisioning
# steps fail with a clear retryable "gitea admin not configured" error until this is set).
# EIDOLON_GITEA_ADMIN_TOKEN=
# Dev/test only: allow hard-deleting employees (business flow uses offboarding).
# EIDOLON_ALLOW_HARD_DELETE=false

# ---- Eidolon Frontend (Vite, 必须 VITE_ 前缀) ----
# Optional escape hatch: point the SPA at a non-same-origin API.
# Default (unset/empty) = same-origin relative paths; /api and /ws are
# proxied to the backend by the Vite dev server (and nginx in docker).
# VITE_API_BASE_URL=http://192.168.1.10:26881

# ---- Secrets（示例，真实值禁止提交 Git）----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
