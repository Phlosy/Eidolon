# Eidolon v2 configuration (copied to .env by `make install`; .env is never committed).
# Every setting is read by apps/server/eidolon/config.py with the EIDOLON_V2_ prefix.

# --- processes & ports (docs/ports.md) ---------------------------------------------
EIDOLON_WEB_PORT=26880
EIDOLON_V2_API_HOST=127.0.0.1
EIDOLON_V2_API_PORT=26881

# --- database: PostgreSQL only; the test database name must end in _test ------------
EIDOLON_V2_DATABASE_URL=postgresql+psycopg://eidolon:eidolon@127.0.0.1:5433/eidolon
EIDOLON_V2_TEST_DATABASE_URL=postgresql+psycopg://eidolon:eidolon@127.0.0.1:5433/eidolon_test

# --- storage (relative to apps/server) ----------------------------------------------
EIDOLON_V2_TRANSCRIPT_DIR=data/transcripts
EIDOLON_V2_WORKSPACE_ROOT=data/workspaces

# --- model provider (v2-architecture §4.6): kind openai_compatible | anthropic;
#     mode live | record | replay ---------------------------------------------------
EIDOLON_V2_PROVIDER_KIND=openai_compatible
EIDOLON_V2_PROVIDER_MODE=live
EIDOLON_V2_PROVIDER_OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
EIDOLON_V2_PROVIDER_OPENAI_COMPAT_MODEL=deepseek-flash
# EIDOLON_V2_PROVIDER_OPENAI_COMPAT_API_KEY=   # or DEEPSEEK_API_KEY in the shell
# EIDOLON_V2_PROVIDER_ANTHROPIC_API_KEY=       # or ANTHROPIC_API_KEY in the shell
EIDOLON_V2_PROVIDER_ANTHROPIC_MODEL=claude-opus-5-5

# --- API sessions ------------------------------------------------------------------
EIDOLON_V2_SESSION_COOKIE_NAME=eidolon_session
EIDOLON_V2_SESSION_TTL_HOURS=720
EIDOLON_V2_COOKIE_SECURE=false
# Comma-separated origins when the SPA is not served same-origin; empty = same origin only.
EIDOLON_V2_CORS_ORIGINS=

# --- worker & logging --------------------------------------------------------------
EIDOLON_V2_LOG_LEVEL=INFO
EIDOLON_V2_WORKER_POLL_INTERVAL=5
