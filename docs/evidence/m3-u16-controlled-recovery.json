      "after accepted intent before first action",
      "after first action commit",
      "after accepted finish before host close"
    ],
    "crash_24": "New process starts actual ManagementRunner recovery from original DB source and exits after second recovered action commits",
    "repetition": "Two more fresh processes preserve original WorkSession, operation, ToolAudit, Event and Task IDs and actual DecisionRecord results",
    "limits": "Isolated SQLite and real host/domain transactions. Scripted model input and HTTP/RPC transport responses. No paid model or native container evidence is claimed."
  },
  "scenarios": {
    "new_tests": 48,
    "existing_contract_updates": [
      "U8 missing-attempt orphan now gets an explicit technical terminal, still no restart",
      "lifespan starts/stops recovery even when new management admission is disabled; cleanup ordering retained including failures"
    ],
    "coverage": [
      "finish does not fabricate Task or Review completion",
      "original accepted formal verdict executes once",
      "saved read gets one receipt",
      "expired complete receipts may aggregate; expired missing actions may not run",
      "active original waiting and both actual adapters' query/stop methods",
      "404/unknown/deadline/reference unknown preserve native unknown and admission fence",
      "persisted withdrawal and repeated shutdown cancellation",
      "late response identity/authority/stop rechecks",
      "missing or corrupt accepted source",
      "two recovery owners",
      "actual SQLite action-receipt and final-host rejection with rollback and retry",
      "per-action withdrawal",
      "company isolation",
      "latest-source conditional finalization including originally absent attempt",
      "captured finite cohort, page/concurrency limits, cursor retry and in-flight rewind race"
