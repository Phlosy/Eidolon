            "arguments": {
              "content": "#!/usr/bin/env python3\n\"\"\"wc_lite: a tiny, dependency-free `wc` look-alike.\n\nUsage:\n    python wc_lite.py notes.txt          # -> \"3 12 71 notes.txt\" style counts\n    python wc_lite.py -l notes.txt       # lines only\n    python wc_lite.py -w -c notes.txt    # words and characters\n\nCounting rules (documented so behaviour is predictable):\n    lines       number of newline characters (same as `wc -l`)\n    words       whitespace-separated tokens (same as `wc -w`)\n    characters  number of Unicode code points in the decoded text\n\nThe module is importable too: ``count(path)`` returns a ``Count`` namedtuple\nand ``format_counts(...)`` renders it, which is handy for tests.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport sys\nfrom collections import namedtuple\nfrom pathlib import Path\nfrom typing import Iterable, List, Optional, Sequence, Union\n\n__all__ = [\n    \"Count\",\n    \"count\",\n    \"format_counts\",\n    \"build_parser\",\n    \"main\",\n]\n\n#: Result of :func:`count`.  Field order matches `wc`'s output order.\nCount = namedtuple(\"Count\", [\"lines\", \"words\", \"chars\"])\n\nPathLike = Union[str, \"Path\"]\n\n\ndef count(path: PathLike) -> Count:\n    \"\"\"Count lines, words and characters in ``path``.\n\n    Raises:\n        FileNotFoundError: the path does not exist.\n        IsADirectoryError: the path is a directory.\n        OSError: any other I/O problem (e.g. permission denied).\n    \"\"\"\n    p = Path(path)\n    # Read bytes first, then decode, so we control the decoding ourselves and\n    # never crash on odd bytes (undecodable bytes become lone surrogates).\n    raw = p.read_bytes()\n    text = raw.decode(\"utf-8\", errors=\"surrogateescape\")\n\n    lines = text.count(\"\\n\")\n    words = len(text.split())\n    chars = len(text)\n    return Count(lines, words, chars)\n\n\ndef _selected_fields(args: argparse.Namespace) -> List[str]:\n    \"\"\"Return the requested fields in canonical (lines, words, chars) order.\"\"\"\n    any_flag = args.lines or args.words or args.chars\n    selected = []\n    if args.lines or not any_flag:\n        selected.append(\"lines\")\n    if args.words or not any_flag:\n        selected.append(\"words\")\n    if args.chars or not any_flag:\n        selected.append(\"chars\")\n    return selected\n\n\ndef format_counts(result: Count, fields: Iterable[str] = (\"lines\", \"words\", \"chars\")) -> str:\n    \"\"\"Render a :class:`Count` as a single space-separated line (no name).\"\"\"\n    return \" \".join(str(getattr(result, name)) for name in fields)\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(\n        prog=\"wc_lite\",\n        description=\"Print line, word and character counts for a file.\",\n    )\n    parser.add_argument(\"path\", help=\"file to inspect\")\n    parser.add_argument(\"-l\", \"--lines\", action=\"store_true\", help=\"show line count\")\n    parser.add_argument(\"-w\", \"--words\", action=\"store_true\", help=\"show word count\")\n    parser.add_argument(\"-c\", \"--chars\", action=\"store_true\", help=\"show character count\")\n    return parser\n\n\ndef main(argv: Optional[Sequence[str]] = None) -> int:\n    \"\"\"Entry point.  Returns the process exit status.\"\"\"\n    args = build_parser().parse_args(argv)\n\n    try:\n        result = count(args.path)\n    except FileNotFoundError:\n        print(\"wc_lite: error: {}: no such file\".format(args.path), file=sys.stderr)\n        return 1\n    except IsADirectoryError:\n        print(\"wc_lite: error: {}: is a directory\".format(args.path), file=sys.stderr)\n        return 1\n    except OSError as exc:\n        print(\"wc_lite: error: {}: {}\".format(args.path, exc.strerror or exc), file=sys.stderr)\n        return 1\n\n    print(format_counts(result, _selected_fields(args)))\n    return 0\n\n\nif __name__ == \"__main__\":  # pragma: no cover\n    sys.exit(main())\n",
