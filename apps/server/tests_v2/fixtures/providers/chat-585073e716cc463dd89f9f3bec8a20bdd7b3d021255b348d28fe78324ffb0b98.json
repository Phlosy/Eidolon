              "content": "\"\"\"Tests for wc_lite (pytest, standard library only).\"\"\"\n\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nimport wc_lite\n\nTOOL = Path(__file__).resolve().parent / \"wc_lite.py\"\n\n\ndef run_cli(*args):\n    \"\"\"Run wc_lite.py as a real subprocess with this interpreter.\"\"\"\n    return subprocess.run(\n        [sys.executable, str(TOOL), *args],\n        capture_output=True,\n        text=True,\n    )\n\n\n# --- Python API -----------------------------------------------------------\n\n\ndef test_count_simple_text(tmp_path):\n    f = tmp_path / \"notes.txt\"\n    f.write_text(\"alpha beta\\ngamma\\n\", encoding=\"utf-8\")\n\n    result = wc_lite.count(f)\n\n    assert result == wc_lite.Count(lines=2, words=3, chars=17)\n    # field access also works positionally, wc-style\n    assert tuple(result) == (2, 3, 17)\n\n\ndef test_count_without_trailing_newline(tmp_path):\n    f = tmp_path / \"no_newline.txt\"\n    f.write_text(\"one two three\", encoding=\"utf-8\")\n\n    result = wc_lite.count(f)\n\n    assert result.lines == 0  # same convention as `wc -l`\n    assert result.words == 3\n    assert result.chars == 13\n\n\ndef test_count_empty_file(tmp_path):\n    f = tmp_path / \"empty.txt\"\n    f.write_text(\"\", encoding=\"utf-8\")\n\n    assert wc_lite.count(f) == wc_lite.Count(0, 0, 0)\n\n\ndef test_count_non_ascii_counts_characters_not_bytes(tmp_path):\n    f = tmp_path / \"unicode.txt\"\n    f.write_text(\"héllo wörld\\n\", encoding=\"utf-8\")\n\n    result = wc_lite.count(f)\n\n    assert result.words == 2\n    assert result.chars == 12  # 11 characters + newline, not 15 UTF-8 bytes\n\n\ndef test_count_missing_file_raises(tmp_path):\n    with pytest.raises(FileNotFoundError):\n        wc_lite.count(tmp_path / \"nope.txt\")\n\n\n# --- CLI through subprocess ----------------------------------------------\n\n\ndef test_cli_prints_all_three_by_default(tmp_path):\n    f = tmp_path / \"notes.txt\"\n    f.write_text(\"hello world\\nsecond line\\n\", encoding=\"utf-8\")\n\n    proc = run_cli(str(f))\n\n    assert proc.returncode == 0\n    assert proc.stderr == \"\"\n    assert proc.stdout.strip() == \"2 4 24\"\n\n\n@pytest.mark.parametrize(\n    \"flags, expected\",\n    [\n        ((\"-l\",), \"2\"),\n        ((\"-w\",), \"4\"),\n        ((\"-c\",), \"24\"),\n    ],\n)\ndef test_cli_single_flags(tmp_path, flags, expected):\n    f = tmp_path / \"notes.txt\"\n    f.write_text(\"hello world\\nsecond line\\n\", encoding=\"utf-8\")\n\n    proc = run_cli(*flags, str(f))\n\n    assert proc.returncode == 0\n    assert proc.stdout.strip() == expected\n\n\ndef test_cli_combined_flags_keep_canonical_order(tmp_path):\n    f = tmp_path / \"notes.txt\"\n    f.write_text(\"hello world\\nsecond line\\n\", encoding=\"utf-8\")\n\n    proc = run_cli(\"-c\", \"-l\", str(f))\n\n    assert proc.returncode == 0\n    assert proc.stdout.strip() == \"2 24\"  # lines before chars regardless of flag order\n\n\ndef test_cli_missing_file_exits_1_with_stderr_message(tmp_path):\n    missing = tmp_path / \"ghost.txt\"\n\n    proc = run_cli(str(missing))\n\n    assert proc.returncode == 1\n    assert proc.stdout == \"\"\n    assert \"no such file\" in proc.stderr.lower()\n    assert str(missing) in proc.stderr\n\n\ndef test_main_returns_status_for_missing_file(tmp_path, capsys):\n    status = wc_lite.main([str(tmp_path / \"ghost.txt\")])\n\n    captured = capsys.readouterr()\n    assert status == 1\n    assert captured.out == \"\"\n    assert \"error\" in captured.err.lower()\n",
