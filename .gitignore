# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
# 仓库内不应出现 .venv：后端统一用本地 conda 环境（见 Makefile / CONTRIBUTING）。
# 这两行只为了防止有人不当心提交。
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
*.log

# Eidolon runtime data (workspaces, sqlite db, logs, pids)
data/
.run/

# Browser agent debug artifacts
.playwright-mcp/
.chrome-mcp/

# OS / Editor
.DS_Store
.idea/
.vscode/

# Temporary/debug artifacts
/tmp-*
