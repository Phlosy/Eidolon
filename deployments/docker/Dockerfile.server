FROM python:3.12-slim

WORKDIR /app

COPY apps/server/pyproject.toml apps/server/README.md apps/server/requirements.lock apps/server/alembic-v2.ini ./
COPY apps/server/eidolon ./eidolon
# The runner is a separate, key-less package the worker spawns per task workspace.
COPY apps/runner /app/runner

RUN python -m pip install --no-cache-dir -r requirements.lock \
    && python -m pip install --no-build-isolation --no-cache-dir --no-deps . \
    && python -m pip install --no-cache-dir --no-deps /app/runner

EXPOSE 26881

# One image, two processes: `api` (this CMD) and `worker` (compose overrides the command).
# The API migrates first so a fresh database comes up at head; the worker waits for it.
CMD ["sh", "-c", "python -m eidolon migrate && python -m eidolon api --host 0.0.0.0 --port 26881"]
