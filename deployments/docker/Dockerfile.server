FROM python:3.12-slim

WORKDIR /app

COPY apps/server/pyproject.toml apps/server/README.md apps/server/requirements.lock apps/server/alembic.ini ./
COPY apps/server/app ./app
COPY apps/server/migrations ./migrations

RUN python -m pip install --no-cache-dir -r requirements.lock \
    && python -m pip install --no-build-isolation --no-cache-dir --no-deps .

EXPOSE 26881

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "26881"]
